    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.4.1",
    "axios": "^1.9.0",
    "boring-avatars": "^1.11.2",
    "date-fns": "^4.1.0",
    "formik": "^2.4.6",
    "framer-motion": "^11.18.2",
    "lightningcss": "^1.30.1",
    "lodash": "^4.17.21",
    "msw": "2.7.6",
    "query-string": "^9.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.0.0",
